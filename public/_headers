# Long-term caching for fingerprinted build assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Hero / favicon — stable filenames, so a shorter TTL with background revalidation
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Self-hosted fonts never change
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache HTML so new deploys take effect immediately
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
